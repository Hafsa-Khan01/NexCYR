# NexCYR environment configuration
# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=sqlite:///./nexcyr.db

# Optional external AI provider (OpenAI-compatible).
# Leave empty to run the NexCYR Intelligence Fallback Engine,
# which answers from the local database without any external API.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: explicit path to the nmap executable.
# NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe
