# NexCYR environment configuration
# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=sqlite:///./nexcyr.db

# Optional external AI provider (OpenAI-compatible).
# Leave empty to run the NexCYR Intelligence Fallback Engine,
# which answers from the local database without any external API.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: explicit path to the nmap executable.
# NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe

# --- Container / VPS deploys ---
# State must live on a mounted volume or a real disk, never on an ephemeral
# container filesystem, or it is wiped on every deploy.
# Note the FOUR slashes: that makes the path absolute.
#
# Container (Dockerfile, Railway, Fly.io):
# DATABASE_URL=sqlite:////data/nexcyr.db
# REPORTS_DIR=/data/reports
#
# VPS (deploy/setup-vps.sh):
# DATABASE_URL=sqlite:////var/lib/nexcyr/nexcyr.db
# REPORTS_DIR=/var/lib/nexcyr/reports
#
# Managed Postgres instead of SQLite (no code changes required):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/nexcyr
